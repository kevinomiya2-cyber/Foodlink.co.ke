rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isCustomerRole(role) { return role in ['customer', 'chef', 'supplier', 'rider']; }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isVerified == resource.data.isVerified;
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if resource.data.isActive == true || isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /menuItems/{itemId} {
      allow read: if resource.data.isAvailable == true || isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
          && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId == request.auth.uid);
      allow create, update, delete: if isAdmin()
        || (signedIn() && request.resource.data.vendorId is string
          && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
          && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.ownerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid
        || resource.data.vendorOwnerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /supplierProducts/{productId} {
      allow read: if resource.data.isAvailable == true || isAdmin()
        || (signedIn() && resource.data.supplierId == request.auth.uid);
      allow write: if isAdmin() || (signedIn()
        && request.resource.data.supplierId == request.auth.uid
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'supplier');
    }

    match /partnerApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole in ['chef', 'supplier', 'rider'];
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /deliveryJobs/{jobId} {
      allow read: if signedIn() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
